# Copy to .env.local. Placeholders only; never commit real values.
DATABASE_URL=postgres://holdfast:holdfast@localhost:5432/holdfast
REDIS_URL=redis://localhost:6379
# The browser origin; state-changing requests from anywhere else are refused.
APP_ORIGIN=http://localhost:5173
# Keys bidder aliases. Any 32+ characters locally; a real random secret when deployed.
SESSION_SECRET=local-dev-only-not-a-secret-0000000000
# Development only: POST /auth/dev signs in without GitHub. Refused in production.
DEV_SIGN_IN=1
# GitHub OAuth app (optional locally): callback is APP_ORIGIN/api/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Stripe test mode only: the code refuses anything but sk_test_. Used by pnpm test:live.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the dashboard's webhook endpoint when deployed.
STRIPE_WEBHOOK_SECRET=
