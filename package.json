{
  "name": "holdfast",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:live": "STRIPE_LIVE_TEST=1 vitest run --project live",
    "db:generate": "pnpm --filter @holdfast/server db:generate",
    "db:migrate": "pnpm --filter @holdfast/server db:migrate",
    "seed": "pnpm --filter @holdfast/server seed",
    "dev": "pnpm --parallel --filter @holdfast/server --filter @holdfast/web dev",
    "dev:server": "pnpm --filter @holdfast/server dev",
    "test:e2e": "playwright test --project e2e",
    "test:e2e:stripe": "E2E_STRIPE=1 playwright test --project e2e-stripe",
    "test:smoke": "playwright test --project smoke",
    "railway:env": "node scripts/railway-env.ts",
    "stripe:webhook": "node server/scripts/stripe-webhook.ts",
    "load": "load/run.sh",
    "load:stack": "load/stack.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@railway/cli": "5.71.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "railway": "3.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
