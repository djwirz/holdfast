{
  "name": "@holdfast/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../.env.local src/db/migrate-cli.ts",
    "seed": "node --env-file-if-exists=../.env.local src/seed.ts",
    "start": "node --env-file-if-exists=../.env.local --import ./src/telemetry.ts src/main.ts",
    "dev": "node src/dev/two-instances.ts",
    "seed:e2e": "node --env-file-if-exists=../.env.local src/seed-e2e.ts"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "3.1.0",
    "@opentelemetry/core": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@testcontainers/postgresql": "^12.2.2",
    "@testcontainers/redis": "12.2.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.2"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/otel": "1.0.1",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/static": "10.1.10",
    "@holdfast/shared": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.0",
    "@opentelemetry/instrumentation": "0.301.0",
    "@opentelemetry/instrumentation-http": "0.301.0",
    "@opentelemetry/instrumentation-ioredis": "0.73.0",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/instrumentation-pino": "0.71.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-node": "0.301.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.12.8",
    "import-in-the-middle": "3.6.0",
    "ioredis": "6.0.0",
    "pg": "^8.23.1",
    "stripe": "23.2.0",
    "zod": "4.6.7"
  }
}
